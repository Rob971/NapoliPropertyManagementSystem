# Copy to deploy/tenants/<customer-id>.env and set TENANT_ID in CI.
# All NEXT_PUBLIC_* vars are baked into the static export at build time.

NEXT_PUBLIC_TENANT_ID=acme
NEXT_PUBLIC_APP_NAME="Acme PMS"
NEXT_PUBLIC_MUNICIPALITY="Comune di Example"
NEXT_PUBLIC_ADMIN_NAME="Admin Example"
# Optional locale-specific admin labels (override NEXT_PUBLIC_ADMIN_NAME):
# NEXT_PUBLIC_ADMIN_NAME_IT="Admin Example"
# NEXT_PUBLIC_ADMIN_NAME_EN="Example Admin"
NEXT_PUBLIC_CLEANER_SUPPLIER="Pulizie Example"

# Set by CI — do not hardcode per customer repo:
# NEXT_PUBLIC_BASE_PATH=/<repository-name>
